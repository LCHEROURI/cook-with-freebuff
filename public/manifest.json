{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/?source=pwa",
  "name": "Cook With Me — Kitchen Agent",
  "short_name": "Cook With Me",
  "description": "Voice-first intelligent cooking companion — hands-free guided cooking step by step",
  "start_url": "/cook",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#FCF8EC",
  "theme_color": "#6B9FD4",
  "orientation": "portrait-primary",
  "categories": ["food", "utilities", "lifestyle"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Start Cooking",
      "short_name": "Cook",
      "description": "Start a new guided cooking session",
      "url": "/cook",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My Kitchen",
      "short_name": "Kitchen",
      "description": "View pantry, groceries, leftovers and dietary profile",
      "url": "/kitchen",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
