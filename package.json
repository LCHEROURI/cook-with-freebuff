{
  "name": "cook-with-freebuff",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy:apphosting": "node scripts/write-commit.mjs && firebase deploy --only apphosting",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:watch": "vitest",
    "test:emulator": "RUN_EMULATOR_TESTS=1 BACKEND_CONTRACT=firestore vitest run --no-file-parallelism lib/server/rollback-resume.emulator.test.ts scripts/cleanup-correlation-markers.emulator.test.ts scripts/firestore-rules-harness.emulator.test.ts lib/server/store-backend-contract.emulator.test.ts",
    "test:sqlconnect": "RUN_SQLCONNECT_EMULATOR_TESTS=1 BACKEND_CONTRACT=sqlconnect vitest run --no-file-parallelism lib/server/sqlconnect-stores.emulator.test.ts lib/server/store-backend-contract.emulator.test.ts",
    "test:rules": "RUN_EMULATOR_TESTS=1 vitest run --no-file-parallelism scripts/firestore-rules*.emulator.test.ts",
    "cleanup:markers": "node --import ./scripts/stub-server-only.mjs --import tsx scripts/cleanup-correlation-markers.ts",
    "tidy:branches": "node scripts/tidy-branches.mjs",
    "refresh:mic-trend": "node scripts/refresh-mic-trend.mjs",
    "verify:mic-trend-zero": "node scripts/mic-trend-gate.mjs",
    "verify:mic-trend-fresh": "node scripts/mic-trend-staleness.mjs",
    "verify:mic-trend-gate-present": "node scripts/mic-trend-gate-presence.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:live:local": "node scripts/verify-live-local.mjs",
    "verify:live:emulator": "node scripts/verify-live-emulator.mjs",
    "verify:live:compare": "node scripts/verify-live-compare.mjs",
    "verify:live:compare:emulator": "node scripts/verify-live-compare-emulator.mjs",
    "verify:real-data": "node scripts/verify-real-data.mjs --confirm-production",
    "verify:deployed-hash": "node scripts/verify-deployed-hash-gate.mjs",
    "verify:gate-fail-proof": "node scripts/verify-teeth-proofs.mjs gate-fail",
    "verify:stale-guard-proof": "node scripts/verify-teeth-proofs.mjs stale-guard",
    "verify:gate-stale-proof": "node scripts/verify-teeth-proofs.mjs gate-stale",
    "verify:teeth-proofs": "node scripts/verify-teeth-proofs.mjs teeth-proofs",
    "verify:hook-block-proof": "node scripts/verify-teeth-proofs.mjs hook-block",
    "authorize:domain": "node scripts/authorize-domain.mjs",
    "admin:list": "node scripts/admin-list-data.mjs",
    "emulators": "npx -y firebase-tools@latest emulators:start --only firestore,auth,ui --project demo-cook-with-freebuff --import emulator-data --export-on-exit emulator-data",
    "emulators:export": "npx -y firebase-tools@latest emulators:export --force --only firestore,auth --project demo-cook-with-freebuff emulator-data",
    "land:pr": "node scripts/land-pr.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0",
    "lucide-react": "^1.37.0",
    "next": "^15.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "axe-core": "^4.13.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.23",
    "jsdom": "^25.0.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
