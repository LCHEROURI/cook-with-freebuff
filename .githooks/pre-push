#!/usr/bin/env bash
# ============================================================================
# .githooks/pre-push — surface the live-vs-local-HEAD delta before a
# production push goes out.
#
# On any push that lands on refs/heads/main, this runs the shared
# verify:deployed-hash gate in --stale-guard mode
# (scripts/verify-deployed-hash-gate.mjs) and mirrors its exit code — the
# SAME direction-aware verdict the CI validate job uses, so the local hook
# and CI can never disagree about what is safe to push. The driver prints the
# full report (live commit, forward-deploy note, or STALE-HEAD BLOCK) and its
# exit code IS the verdict:
#
#   exit 0 → PASS — live is exactly your HEAD, or live is behind your HEAD
#            (a forward deploy; the post-deploy gate verifies after Vercel
#            finishes)
#   exit 1 → BLOCK — the driver printed STALE-HEAD BLOCK (live is not an
#            ancestor of HEAD: pushing would roll the site back or clobber
#            history), or could not determine the live commit at all — a
#            push that cannot be verified is not verified, and must not go
#            out silently
#   exit 2 → invalid/revoked token — cannot verify: WARN + continue (a bad
#            local token must not block a deploy; CI has its own token and
#            the post-deploy gate will verify there)
#
# Escape hatch: SKIP_VERIFY_DEPLOYED_HASH=1 bypasses entirely.
# ============================================================================

set -u

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "pre-push (verify:deployed-hash): could not find the repo root" >&2
  exit 1
}
cd "$ROOT"

# Only production pushes (remote ref refs/heads/main) trigger the check.
MAIN_PUSH=0
while read -r _local_ref _local_sha _remote_ref _remote_sha; do
  case "$_remote_ref" in
    refs/heads/main) MAIN_PUSH=1 ;;
  esac
done

[ "$MAIN_PUSH" -eq 1 ] || exit 0

if [ "${SKIP_VERIFY_DEPLOYED_HASH:-0}" = "1" ]; then
  echo "pre-push: SKIP_VERIFY_DEPLOYED_HASH=1 — skipping the live-vs-HEAD comparison" >&2
  exit 0
fi

echo "pre-push: verifying deployed hash before production push..." >&2

# ONE verdict implementation: the same --stale-guard gate CI runs. No bash
# reimplementation of the direction logic here — the driver's exit code IS
# the verdict and its output IS the report.
node scripts/verify-deployed-hash-gate.mjs --stale-guard >&2
CODE=$?

if [ "$CODE" -eq 0 ]; then
  echo "pre-push: ✓ live-vs-HEAD check passed — safe to push" >&2
  exit 0
fi

if [ "$CODE" -eq 2 ]; then
  echo "pre-push: ⚠ cannot verify the deployed hash (invalid/revoked token) — continuing without the comparison" >&2
  exit 0
fi

echo "pre-push: ✗ BLOCKED — see the verdict above; to override, re-run with SKIP_VERIFY_DEPLOYED_HASH=1" >&2
exit 1
