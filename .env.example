[TEMPLATE]
[TEMPLATE]
# ── Firebase client (safe to expose in the browser bundle) ──────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase admin (server-only — never expose in client code) ──────────────
# Inline service-account JSON (preferred for serverless / Cloud Run).
# On local dev you can also use a file path via FIREBASE_SERVICE_ACCOUNT_PATH.
FIREBASE_SERVICE_ACCOUNT=

# ── AI providers (server-only) ──────────────────────────────────────────────
# Google AI (Gemini) — used by the recipe generation / validation services.
GOOGLE_AI_API_KEY=

# Optional: override the default model names per service.
RECIPE_GENERATION_MODEL=
RECIPE_VALIDATION_MODEL=
CONVERSATION_MODEL=

# ── App ─────────────────────────────────────────────────────────────────────
# The owner's Firebase Auth UID (admin/owner-only operations).
APP_OWNER_UID=

# ── Local Firestore/Auth emulator (optional, for development) ────────────────
# Point the client at the local emulators instead of the production project.
# The Admin SDK reads FIRESTORE_EMULATOR_HOST / FIREBASE_AUTH_EMULATOR_HOST
# automatically. Start them with: npm run emulators
# (the Firestore emulator needs Java 11+; the Emulator UI is at :4000).
NEXT_PUBLIC_USE_FIRESTORE_EMULATOR=
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# ── Ops (server-only, optional) ─────────────────────────────────────────────
# correlation_markers cleanup (scripts/cleanup-correlation-markers.mjs, also
# run weekly by the marker-cleanup GitHub Action). Deletes marker docs older
# than MARKER_TTL_DAYS; DRY_RUN=1 previews without writing.
MARKER_TTL_DAYS=30
DRY_RUN=

# ── Firebase App Hosting secrets (set via firebase apphosting:secrets:set) ──
# These are NOT in .env.local — they live in Cloud Secret Manager.
#   GOOGLE_AI_API_KEY       → firebase apphosting:secrets:set GOOGLE_AI_API_KEY
#   FIREBASE_SERVICE_ACCOUNT → firebase apphosting:secrets:set FIREBASE_SERVICE_ACCOUNT
